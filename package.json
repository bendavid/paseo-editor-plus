{
  "name": "paseo-typst-tinymist",
  "private": true,
  "version": "0.1.0",
  "description": "Edit Typst in Paseo with tinymist: completion, diagnostics, and a live preview that follows the cursor.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bendavid/paseo-typst-tinymist.git"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/lsp-client": "6.3.0",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5"
  },
  "devDependencies": {
    "@getpaseo/plugin": "^0.13.0",
    "@tanstack/react-query": "^5.104.5",
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.0",
    "esbuild": "^0.27.7",
    "prettier": "^3.9.10",
    "react": "^19.1.0",
    "react-native": "^0.81.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "zod": "^4.6.7"
  }
}
