{
  "name": "paseo-editor-plus",
  "private": true,
  "version": "0.1.0",
  "description": "A code editor for Paseo's file tab with language servers and live previews: Typst with tinymist first.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bendavid/paseo-editor-plus.git"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "node scripts/embed-pdfjs.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-go": "6.0.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-less": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-rust": "6.0.2",
    "@codemirror/lang-sass": "6.0.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/lint": "6.9.7",
    "@codemirror/lsp-client": "6.3.0",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@marp-team/marp-core": "4.4.0",
    "codemirror-lang-typst": "0.6.0",
    "markdown-it": "15.0.3",
    "pdfjs-dist": "6.4.299"
  },
  "devDependencies": {
    "@getpaseo/plugin": "^0.13.0",
    "@tanstack/react-query": "^5.104.5",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.0",
    "esbuild": "^0.27.7",
    "prettier": "^3.9.10",
    "react": "^19.1.0",
    "react-native": "^0.81.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "zod": "^4.6.7"
  }
}
